pkgname=VRCVideoLogViewer
pkgver=1.2.0
pkgrel=1
pkgdesc="A tool for parsing VRChat logs to collect links to videos, images, and text content."
arch=('x86_64')
url="https://github.com/nicovrc-net/VRCVideoLogViewer"
license=('MIT')
depends=('jdk21-openjdk' 'imagemagick' 'noto-fonts-cjk')
makedepends=('git' 'curl')
source=( "$pkgname::git+https://github.com/nicovrc-net/VRCVideoLogViewer.git#branch=release" "7z2501-linux-x64.tar.xz::https://www.7-zip.org/a/7z2501-linux-x64.tar.xz" "openjfx-21.0.10_linux-x64_bin-sdk.zip::https://download2.gluonhq.com/openjfx/21.0.10/openjfx-21.0.10_linux-x64_bin-sdk.zip")
sha256sums=('SKIP' 'SKIP' 'SKIP')

options=('!debug')

build() {
    cd "$srcdir/$pkgname"
    chmod +x gradlew
    ./gradlew shadowJar
}

package() {
    cd "$srcdir/$pkgname"

    mkdir ./7z2501
    tar -Jxvf "$srcdir/7z2501-linux-x64.tar.xz" -C ./7z2501
    chmod +x ./7z2501/7zz

    sed -i 's/^## cd/cd/' ./run-batch/start_forLinux.sh
    install -Dm755 "./run-batch/start_forLinux.sh" "$pkgdir/usr/share/$pkgname/start_forLinux.sh"
    install -Dm666 "./linux-package/config_for_package.txt" "$pkgdir/usr/share/$pkgname/config.yml"

    install -Dm755 "./lang/ja.txt" "$pkgdir/usr/share/$pkgname/lang/ja.txt"
    install -Dm755 "./lang/en.txt" "$pkgdir/usr/share/$pkgname/lang/en.txt"
    install -Dm755 "./lang/ko.txt" "$pkgdir/usr/share/$pkgname/lang/ko.txt"
    install -Dm755 "./lang/zh-Hans.txt" "$pkgdir/usr/share/$pkgname/lang/zh-Hans.txt"
    install -Dm755 "./lang/zh-Hant.txt" "$pkgdir/usr/share/$pkgname/lang/zh-Hant.txt"

    install -Dm644 "build/libs/VRCVideoLogViewer-1.0-SNAPSHOT-all.jar" "$pkgdir/usr/share/$pkgname/VRCVideoLogViewer-1.0-SNAPSHOT-all.jar"

    install -d "$pkgdir/usr/share/$pkgname/tools/7z2501"
    install -d "$pkgdir/usr/share/$pkgname/tools/jdk-21/bin"
    ln -s /usr/lib/jvm/java-21-openjdk/bin/java "$pkgdir/usr/share/$pkgname/tools/jdk-21/bin/java"

    install -d "$pkgdir/usr/share/$pkgname/tools/javafx-sdk-21"
    ./7z2501/7zz x -o"$pkgdir/usr/share/$pkgname/tools" "$srcdir/openjfx-21.0.10_linux-x64_bin-sdk.zip"
    mv "$pkgdir/usr/share/$pkgname/tools/javafx-sdk-21.0.10" "$pkgdir/usr/share/$pkgname/tools/javafx-sdk-21"

    install -dm755 "$pkgdir/usr/share/$pkgname/tools/ImageMagick"
    ln -s /usr/bin/magick "$pkgdir/usr/share/$pkgname/tools/ImageMagick/magick"

    ln -s "$pkgdir/usr/share/$pkgname/start_forLinux.sh" "/$pkgdir/usr/bin/$pkgname"

    find "$pkgdir/usr/share/$pkgname" -type f -exec file {} \; | grep ELF | cut -d: -f1 | while read -r elf; do
        strip --strip-all "$elf" || true
    done

}