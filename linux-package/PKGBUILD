pkgname=VRCVideoLogViewer
pkgver=1.0.0
pkgrel=1
pkgdesc="A tool for parsing VRChat logs to collect links to videos, images, and text content."
arch=('x86_64')
url="https://github.com/nicovrc-net/VRCVideoLogViewer"
license=('MIT')
depends=('imagemagick')
makedepends=('git' '7zip' 'jdk21-openjdk' 'curl' 'screen')
source=("$pkgname::git+https://github.com/nicovrc-net/VRCVideoLogViewer.git#branch=release")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"
  chmod +x gradlew
  ./gradlew shadowJar
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm755 "./run-batch/start_forArchLinux_aur.sh" "$pkgdir/usr/share/$pkgname/start_forLinux.sh"

  install -Dm755 "./lang/ja.txt" "$pkgdir/usr/share/$pkgname/lang/ja.txt"
  install -Dm755 "./lang/ko.txt" "$pkgdir/usr/share/$pkgname/lang/ko.txt"
  install -Dm755 "./lang/zh-Hans.txt" "$pkgdir/usr/share/$pkgname/lang/zh-Hans.txt"
  install -Dm755 "./lang/zh-Hant.txt" "$pkgdir/usr/share/$pkgname/lang/zh-Hant.txt"

  install -Dm644 "build/libs/VRCVideoLogViewer-1.0-SNAPSHOT-all.jar" "$pkgdir/usr/share/$pkgname/VRCVideoLogViewer-1.0-SNAPSHOT-all.jar"

  install -d "$pkgdir/usr/share/$pkgname/tools/7z2501"

  curl https://download.java.net/java/GA/jdk21.0.2/f2283984656d49d69e91c558476027ac/13/GPL/openjdk-21.0.2_linux-x64_bin.tar.gz --output "./openjdk-21.0.2_linux-x64_bin.tar.gz"
  tar -zxvf "./openjdk-21.0.2_linux-x64_bin.tar.gz"
  chmod +x "./jdk-21.0.2/bin/java"
  install -d "$pkgdir/usr/share/$pkgname/tools/jdk-21.0.2"
  cp -a "./jdk-21.0.2" "$pkgdir/usr/share/$pkgname/tools/"

  for f in "$pkgdir/usr/share/$pkgname/tools/jdk-21.0.2/lib/*"; do
    f=${basename "${f}"}
    objcopy --remove-section=.gnu_debuglink "$pkgdir/usr/share/$pkgname/tools/jdk-21.0.2/lib/${f}"
  done

  install -d "$pkgdir/usr/share/$pkgname/tools/javafx-sdk-21.0.9"
  curl https://download2.gluonhq.com/openjfx/21.0.9/openjfx-21.0.9_linux-x64_bin-sdk.zip --output "./openjfx-21.0.9_linux-x64_bin-sdk.zip"
  7z x -o"$pkgdir/usr/share/$pkgname/tools/javafx-sdk-21.0.9" "./openjfx-21.0.9_linux-x64_bin-sdk.zip"

  install -dm755 "$pkgdir/usr/share/$pkgname/tools/ImageMagick"
  ln -s /usr/bin/magick "$pkgdir/usr/share/$pkgname/tools/ImageMagick/magick"

  screen -UAmdS config-create java -jar ./build/libs/VRCVideoLogViewer-1.0-SNAPSHOT-all.jar
  sleep 1s
  screen -S config-create -X quit

  install -Dm666 "./config.yml" "$pkgdir/usr/share/$pkgname/config.yml"

}